---
import Base from "../layouts/Base.astro";
import Button from "../components/Button.astro";
import Icon from "../components/Icon.astro";
import Stats from "../components/Stats.astro";
import Cta from "../components/Cta.astro";
import { b, em, words, range } from "../blanks";
---
<Base title="Partners">
  <section id="partners-hero" class="flex min-h-[80svh] flex-col items-center justify-center px-6 pb-12 pt-32 text-center">
    <h1 class="max-w-[16ch] text-h1" data-split data-now set:html={words(b("partners.title"))} />
    <p class="mt-10 max-w-xl text-lead text-muted" data-reveal>{b("partners.body")}</p>
    <div class="mt-9" data-reveal><Button href={`mailto:${b("link.email")}`}>Talk with us</Button></div>
  </section>

  <section id="benefits" class="mx-auto max-w-[64rem] space-y-6 px-6 py-16">
    {range(3).map((i) => (
      <article class:list={["grid items-center gap-8 rounded-[1.75rem] p-8 md:grid-cols-2 md:p-12", i % 2 === 0 && "md:[&>*:first-child]:order-2"]} style={`background: var(--hs-tone-${i + 1})`} data-reveal>
        <div class="grid aspect-[4/3] place-items-center rounded-2xl bg-canvas/60"><Icon name={b(`benefit.${i}.icon`)} class="size-32 text-ink" /></div>
        <div>
          <h2 class="text-h2">{b(`benefit.${i}.title`)}</h2>
          <p class="mt-5 max-w-md">{b(`benefit.${i}.body`)}</p>
        </div>
      </article>
    ))}
  </section>

  <section id="why" class="mx-auto max-w-[64rem] px-6 py-24">
    <h2 class="mx-auto max-w-[14ch] text-center text-h2" data-split set:html={words(b("why.title"))} />
    <div class="mt-14 grid gap-4 md:grid-cols-3" data-stagger>
      {range(3).map((i) => (
        <article class="rounded-2xl border border-line bg-raised p-7">
          <p class="font-display text-h3 text-accent-ink">0{i}</p>
          <h3 class="mt-8 text-h3" set:html={em(b(`why.${i}.title`))} />
          <p class="mt-4 text-[0.95rem] text-muted">{b(`why.${i}.body`)}</p>
        </article>
      ))}
    </div>
  </section>

  <Stats />
  <Cta />
</Base>
