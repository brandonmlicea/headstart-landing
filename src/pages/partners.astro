---
import Base from "../layouts/Base.astro";
import Band from "../components/Band.astro";
import Pixel from "../components/Pixel.astro";
import { b, tone, range } from "../blanks";
const scenes = ["dawn", "noon", "dusk"];
---
<Base title={b("nav.partners")} solid>
  <section id="partners-hero" class="mx-auto max-w-[68rem] px-5 pb-16 pt-44 md:px-6">
    <p class="eyebrow" data-reveal>{b("nav.partners")}</p>
    <h1 class="mt-6 max-w-[20ch] text-hero text-ink" data-reveal set:html={tone(b("partners.title"))} />
    <p class="mt-6 max-w-xl text-body text-body" data-reveal>{b("partners.body")}</p>
    <div class="mt-8 flex flex-wrap gap-3" data-reveal>
      <a href={`mailto:${b("link.email")}`} id="partners-cta" class="btn btn-dark">{b("partners.cta")}</a>
      <a href={b("link.app")} class="btn btn-light">{b("nav.cta")}</a>
    </div>
  </section>

  {range(3).map((i) => (
    <section id={`benefit-${i}`} class="mx-auto grid max-w-[68rem] items-center gap-12 px-5 py-16 md:px-6 lg:grid-cols-2">
      <div class:list={[i === 2 && "lg:order-2"]}>
        <p class="eyebrow" data-reveal>0{i} — {b("nav.partners")}</p>
        <h2 class="mt-6 text-[2rem] leading-[1.25] text-ink" data-reveal set:html={tone(b(`benefit.${i}.title`))} />
        <p class="mt-5 max-w-md text-body text-body" data-reveal>{b(`benefit.${i}.body`)}</p>
      </div>
      <div class="frame p-3" data-reveal>
        <Pixel scene={scenes[i - 1]} w={320} h={200} seed={20 + i} class="aspect-[16/10] w-full rounded-[10px]" />
      </div>
    </section>
  ))}

  <section id="why" class="mx-auto max-w-[68rem] px-5 py-24 md:px-6">
    <h2 class="max-w-[20ch] text-h2 text-ink" data-reveal set:html={tone(b("why.title"))} />
    <div class="mt-12 grid gap-8 text-body text-body md:grid-cols-3" data-stagger>
      {range(3).map((i) => <p><strong class="font-[560] text-ink">{b(`why.${i}.title`)}</strong> — {b(`why.${i}.body`)}</p>)}
    </div>
  </section>
  <Band />
</Base>
