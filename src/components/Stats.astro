---
import { b, words, range } from "../blanks";
---
<section id="stats" class="mx-auto max-w-[64rem] px-6 py-24">
  <h2 class="max-w-[18ch] text-h2" data-split set:html={words(b("stats.title"))} />
  <div class="mt-16 grid gap-10 border-t border-line pt-12 md:grid-cols-3" data-stagger>
    {range(3).map((i) => (
      <div>
        <p class="flex flex-wrap items-baseline gap-x-3 font-display text-h1 text-accent-ink"><span data-count={b(`stat.${i}.value`)}>{b(`stat.${i}.value`)}</span><span class="whitespace-nowrap text-h3 text-ink">{b(`stat.${i}.unit`)}</span></p>
        <p class="mt-4 max-w-xs text-muted">{b(`stat.${i}.label`)}<sup><a href={`#source-${i}`} class="ml-0.5 text-accent-ink">{i}</a></sup></p>
      </div>
    ))}
  </div>
  <ol class="mt-14 space-y-1 text-sm text-muted">
    {range(3).map((i) => <li id={`source-${i}`}>{i}. {b(`stat.${i}.source`)}</li>)}
  </ol>
</section>
