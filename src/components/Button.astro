---
interface Props { href: string; kind?: "fill" | "line" | "plain"; class?: string }
const { href, kind = "fill", class: cls = "" } = Astro.props;
const look = {
  fill: "bg-accent-fill text-on-accent hover:brightness-110",
  line: "border border-ink/25 text-ink hover:bg-ink/5",
  plain: "bg-canvas text-ink hover:bg-raised",
}[kind];
---
<a href={href} class:list={["group inline-flex items-center gap-2 rounded-full px-5 py-3 text-[0.95rem] font-medium transition duration-300 active:scale-[0.97]", look, cls]}>
  <slot />
  <svg class="size-4 transition-transform duration-300 group-hover:translate-x-0.5" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" aria-hidden="true"><path d="M3 8h10M9 4l4 4-4 4" /></svg>
</a>
