---
import { b, em, range } from "../blanks";
import Icon from "./Icon.astro";
const n = range(4);
---
<section id="care" class="relative" data-pillars aria-roledescription="carousel" aria-label="How we care">
  <div class="relative flex min-h-svh items-center justify-center overflow-hidden px-4 py-24" data-stage>
    {n.map((i) => <div class="absolute inset-0 opacity-0 first-of-type:opacity-100" style={`background: radial-gradient(120% 90% at ${20 + i * 18}% ${i % 2 ? 20 : 80}%, var(--hs-tone-${i}), var(--hs-tone-${(i % 5) + 1}))`} data-pillar-bg />)}
    <svg class="pointer-events-none absolute inset-0 size-full text-ink/10" aria-hidden="true"><defs><pattern id="pillar-grid" width="44" height="44" patternUnits="userSpaceOnUse"><path d="M44 0H0v44" fill="none" stroke="currentColor" /></pattern></defs><rect width="100%" height="100%" fill="url(#pillar-grid)" /></svg>
    <div class="relative grid w-full max-w-2xl rounded-[1.75rem] bg-canvas p-8 text-center shadow-[0_30px_80px_-30px_rgb(0_0_0/0.35)] md:p-14">
      {n.map((i) => (
        <article class="pillar col-start-1 row-start-1 flex flex-col items-center" data-pillar aria-label={`${i} of 4`}>
          <h2 class="max-w-[14ch] text-h2" set:html={em(b(`pillar.${i}.title`))} />
          <p class="mt-6 max-w-md text-muted">{b(`pillar.${i}.body`)}</p>
          <div class="mt-8 text-ink"><Icon name={b(`pillar.${i}.icon`)} class="size-24" draw={false} /></div>
        </article>
      ))}
      <div class="mt-8 flex items-center justify-between">
        <div class="flex gap-2">
          <button class="grid size-9 place-items-center rounded-lg bg-surface transition hover:bg-line" data-prev aria-label="Previous">‹</button>
          <button class="grid size-9 place-items-center rounded-lg bg-surface transition hover:bg-line" data-next aria-label="Next">›</button>
        </div>
        <div class="flex gap-2">{n.map((i) => <button class="h-2.5 w-2.5 rounded-full bg-line transition-all aria-[current=true]:w-6 aria-[current=true]:bg-accent-fill" data-dot aria-label={`Show ${i}`} />)}</div>
      </div>
    </div>
  </div>
</section>
<style is:global>
  .js [data-pillars]:not(.is-live) .pillar:not(:first-of-type) { visibility: hidden; }
</style>
