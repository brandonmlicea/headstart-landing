---
import { b, tone, range } from "../blanks";
import Pixel from "./Pixel.astro";
---
<section id="sky" class="relative overflow-hidden" data-tools>
  <Pixel scene="sky" w={720} h={450} seed={3} dissolve="top bottom" class="absolute inset-0 size-full object-cover" />
  <div class="pointer-events-none absolute inset-x-0 top-0 h-[70%] bg-[radial-gradient(55%_60%_at_50%_30%,oklch(0.36_0.12_255/0.55),transparent_75%)]" aria-hidden="true"></div>
  <div class="relative px-5 pb-40 pt-36 text-center text-white md:px-6">
    <h2 class="mx-auto max-w-[22ch] text-h2 [text-shadow:0_1px_12px_oklch(0.3_0.1_255/0.4)] [&_em]:text-white/80" data-reveal set:html={tone(b("tools.title"))} />
    <p class="mx-auto mt-5 max-w-xl text-[15px] font-[560] [text-shadow:0_1px_8px_oklch(0.3_0.1_255/0.5)]" data-reveal>{b("tools.body")}</p>
    <div class="mx-auto mt-10 grid max-w-3xl gap-4 text-left text-[15px] font-[560] sm:grid-cols-3" data-reveal>
      {range(3).map((i) => (
        <p class="border-l-2 border-white/40 pl-4 transition-all duration-500 data-[on]:border-white data-[on]:[text-shadow:0_1px_10px_oklch(0.3_0.1_255/0.6)] [&:not([data-on])]:opacity-80" data-tool data-on={i === 1 ? "" : undefined}>{b(`tools.${i}`)}</p>
      ))}
    </div>
    <div class="mx-auto mt-16 max-w-2xl rounded-[22px] border border-white/40 bg-white/25 p-3 backdrop-blur-sm" data-reveal>
      <div class="rounded-[14px] bg-raised p-5 text-left text-[13px] leading-[1.6] shadow-[0_20px_50px_-20px_oklch(0.2_0.1_255/0.5)]">
        <p class="ml-auto max-w-[80%] rounded-[10px] border border-line bg-surface px-3 py-2 text-ink">{b("mock.user")}</p>
        <p class="mt-4 flex gap-2 text-body"><span class="font-mono text-[10px] text-muted" aria-hidden="true">::</span><span set:html={tone(b("mock.reply"), "strong")} /></p>
        <div class="mt-4 flex items-center gap-2 rounded-[8px] border border-line px-2.5 py-2 text-[11px]">
          <span class="size-2 rounded-full bg-tone-2-ink" aria-hidden="true"></span>
          <strong class="font-[560] text-ink">{b("mock.agent")}</strong>
          <span class="flex-1 truncate text-muted">{b("mock.task")}</span>
        </div>
      </div>
    </div>
  </div>
</section>
