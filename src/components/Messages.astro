---
import { b, range } from "../blanks";
const value = b("step.2.value");
const pct = Math.min(100, Math.max(8, parseFloat(value) || 60));
---
<div id="messages" class="relative h-[500px]" role="img" aria-label={b("msg.subject")}>
  <div class="frame absolute bottom-0 left-0 w-[64%] overflow-hidden p-0 text-[11px]">
    <div class="flex items-center gap-2 border-b border-line px-5 py-3.5 text-[12px] text-ink">
      <span class="grid size-6 place-items-center rounded-md border border-line bg-raised text-[11px] text-accent-ink">✉</span>
      <span class="font-medium">{b("brand.name")}</span>
    </div>
    <dl class="divide-y divide-line px-5">
      <div class="grid grid-cols-[5rem_1fr] py-2.5"><dt class="text-muted">To</dt><dd class="font-medium text-ink">{b("msg.to")}</dd></div>
      <div class="grid grid-cols-[5rem_1fr] py-2.5"><dt class="text-muted">From</dt><dd class="font-medium text-ink">{b("brand.name")}</dd></div>
      <div class="grid grid-cols-[5rem_1fr] py-2.5"><dt class="text-muted">Subject</dt><dd class="font-medium text-ink">{b("msg.subject")}</dd></div>
    </dl>
    <p class="h-36 px-5 pt-4 leading-[1.7] text-body [mask-image:linear-gradient(black_55%,transparent)]">{b("msg.body")}</p>
  </div>
  <div class="frame absolute right-0 top-0 z-10 w-[16rem] p-0 text-[11px]">
    <div class="flex items-center justify-between border-b border-line px-3 py-2.5 text-ink"><span class="font-medium">{b("step.2.metric")}</span><span class="text-muted">×</span></div>
    <div class="p-3">
      <p class="flex items-center gap-2 text-[40px] leading-none tracking-[-0.03em] text-ink"><span data-count={value}>{value}</span></p>
      <div class="mt-4 h-8 overflow-hidden rounded-md bg-surface">
        <div class="h-full rounded-md bg-[linear-gradient(90deg,var(--hs-tone-2),color-mix(in_oklab,var(--hs-tone-2-ink)_45%,var(--hs-tone-2)))] origin-left" style={`width:${pct}%`} data-grow></div>
      </div>
      <ul class="mt-3 divide-y divide-line">
        {range(4).map((i) => (
          <li class="flex items-center justify-between py-2 text-body">
            <span class="truncate pr-2">{b(`step.2.item.${i}.title`)}</span>
            <span class="rounded bg-tone-2 px-1.5 text-[10px] text-tone-2-ink">✓</span>
          </li>
        ))}
      </ul>
    </div>
  </div>
</div>
