---
import { b, plain } from "../blanks";
const year = new Date().getFullYear();
---
<footer id="footer" class="mt-24 bg-surface px-6 pb-10 pt-16">
  <div class="mx-auto grid max-w-[64rem] gap-10 md:grid-cols-[1.4fr_1fr_1fr]">
    <div>
      <p class="font-display text-h3 text-accent-ink">{b("brand.name")}</p>
      <p class="mt-3 max-w-sm text-muted">{plain(b("brand.tagline"))}</p>
    </div>
    <div class="text-sm">
      <p class="text-muted">Visit</p>
      <ul class="mt-3 space-y-2">
        <li><a class="hover:underline" href="/#services">Services</a></li>
        <li><a class="hover:underline" href="/partners">For partners</a></li>
        <li><a class="hover:underline" href={b("link.app")}>{b("nav.cta")}</a></li>
      </ul>
    </div>
    <div class="text-sm">
      <p class="text-muted">Reach us</p>
      <ul class="mt-3 space-y-2">
        <li><a class="hover:underline" href={`mailto:${b("link.email")}`}>{b("link.email")}</a></li>
        <li>{b("brand.location")}</li>
      </ul>
    </div>
  </div>
  <p class="mx-auto mt-14 max-w-[64rem] border-t border-line pt-6 text-sm text-muted">© {year} {b("brand.name")}</p>
</footer>
