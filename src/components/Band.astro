---
import { b } from "../blanks";
---
<section id="band" class="px-5 md:px-6">
  <div class="mx-auto flex max-w-[68rem] flex-col justify-between gap-6 border-y border-line py-8 md:flex-row md:items-center" data-reveal>
    <div>
      <h3 class="text-h3 font-[460] text-ink">{b("band.title")}</h3>
      <p class="mt-1 text-body text-body">{b("band.body")}</p>
    </div>
    <a href={b("link.app")} id="band-cta" class="btn btn-dark self-start md:self-auto">
      {b("band.cta")}
      <svg class="size-4" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" aria-hidden="true"><path d="M3 8h10M9 4l4 4-4 4" /></svg>
    </a>
  </div>
</section>
