---
import { b, em, range } from "../blanks";
---
<section id="services" class="mx-auto max-w-[64rem] px-6 py-20">
  <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3" data-stagger>
    <article class="flex min-h-80 flex-col rounded-2xl bg-surface p-7">
      <p class="text-sm text-muted">{b("services.eyebrow")}</p>
      <h2 class="mt-auto pt-10 text-h3" set:html={em(b("services.title"))} />
      <p class="mt-4 text-[0.95rem] text-muted">{b("services.body")}</p>
    </article>
    {range(5).map((i) => (
      <article class="flex min-h-72 flex-col rounded-2xl p-7 transition duration-500 hover:-translate-y-1" style={`background: var(--hs-tone-${i})`}>
        <h3 class="text-h3">{b(`service.${i}.title`)}</h3>
        <p class="mt-5 text-[0.95rem]">{b(`service.${i}.body`)}</p>
      </article>
    ))}
  </div>
</section>
