---
import { b, tone, range, roman } from "../blanks";
import Pixel from "./Pixel.astro";
const scenes = ["dawn", "noon", "dusk", "night"];
const year = new Date().getFullYear();
---
<section id="guide" class="relative overflow-hidden px-5 py-28 md:px-6">
  <div class="pointer-events-none absolute inset-0 bg-[linear-gradient(oklch(0_0_0/0.035)_1px,transparent_1px),linear-gradient(90deg,oklch(0_0_0/0.035)_1px,transparent_1px)] bg-[size:48px_48px] [mask-image:radial-gradient(60%_60%_at_50%_55%,black,transparent)]" aria-hidden="true"></div>
  <div class="relative text-center">
    <h2 class="mx-auto max-w-[22ch] text-h2 text-ink" data-reveal set:html={tone(b("guide.title"))} />
    <p class="mx-auto mt-5 max-w-md text-body text-body" data-reveal>{b("guide.body")}</p>
    <a href={b("link.app")} id="guide-cta" class="btn btn-dark mt-7" data-reveal>{b("guide.cta")}</a>
  </div>
  <div class="relative mx-auto mt-20 grid max-w-[46rem] gap-x-10 gap-y-14 sm:grid-cols-2" data-stagger>
    {range(4).map((i) => (
      <a href={b("link.app")} class="group block text-center" id={`guide-${i}`}>
        <div class="rounded-[28px] border border-line/70 bg-surface/50 px-5 pt-5 transition-transform duration-500 group-hover:-translate-y-1">
          <div class="relative rounded-t-[10px] border border-b-0 border-line bg-raised p-6 pb-4 text-left shadow-[0_-1px_0_oklch(1_0_0/0.8)_inset,0_10px_30px_-18px_oklch(0_0_0/0.3)]">
            <span class="absolute inset-y-0 left-3 w-px bg-line" aria-hidden="true"></span>
            <p class="pl-2 text-[18px] leading-[1.2] text-ink">Chapter {i}<br />{b(`guide.${i}.title`)}</p>
            <hr class="my-5 border-line" />
            <p class="pl-2 font-mono text-[9px] text-muted">Chapter {roman(i)}</p>
            <Pixel scene={scenes[i - 1]} w={120} h={96} seed={11 + i} class="mt-4 ml-2 aspect-[5/4] w-[calc(100%-0.5rem)] rounded-md" />
            <div class="mt-4 flex justify-between pl-2 font-mono text-[9px] text-muted"><span>by {b("brand.name")}</span><span>{year}</span></div>
          </div>
        </div>
        <p class="mt-5 font-mono text-[12px] text-muted transition-colors group-hover:text-ink">{b("guide.cta")} ({roman(i)})</p>
      </a>
    ))}
  </div>
</section>
