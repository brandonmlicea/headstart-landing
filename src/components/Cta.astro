---
import { b, words } from "../blanks";
import Button from "./Button.astro";
import Icon from "./Icon.astro";
---
<section id="contact" class="px-4 py-12">
  <div class="relative mx-auto max-w-[64rem] overflow-hidden rounded-[2rem] bg-accent-fill px-8 py-20 text-center text-on-accent md:py-28">
    <Icon name="heart" class="absolute -right-6 -top-6 size-48 opacity-20" draw={false} />
    <h2 class="mx-auto max-w-[14ch] text-h1" data-split set:html={words(b("cta.title"))} />
    <p class="mx-auto mt-6 max-w-md text-lead" data-reveal>{b("cta.body")}</p>
    <div class="mt-10 flex flex-wrap justify-center gap-3" data-reveal>
      <Button href={b("link.app")} kind="plain">{b("cta.button")}</Button>
      <a href={`mailto:${b("link.email")}`} class="rounded-full px-5 py-3 text-[0.95rem] underline underline-offset-4">{b("link.email")}</a>
    </div>
  </div>
</section>
